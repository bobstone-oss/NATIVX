{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "NativX",
  "scopeName": "source.nativx",
  "patterns": [
    { "include": "#comments" },
    { "include": "#decorators" },
    { "include": "#keywords" },
    { "include": "#memory_qualifiers" },
    { "include": "#types" },
    { "include": "#hardware_modules" },
    { "include": "#functions" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.nativx",
          "match": "//.*$"
        },
        {
          "name": "comment.block.nativx",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "decorators": {
      "patterns": [
        {
          "name": "entity.name.tag.decorator.nativx",
          "match": "@(entry|gpu_shared|gpu_vertex|gpu_fragment|gpu_compute|component|system|hardware)\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.nativx",
          "match": "\\b(if|else|for|in|while|break|continue|return|await|async)\\b"
        },
        {
          "name": "keyword.other.nativx",
          "match": "\\b(use|pub|struct|fn|true|false)\\b"
        }
      ]
    },
    "memory_qualifiers": {
      "patterns": [
        {
          "name": "storage.modifier.arena.nativx",
          "match": "\\b(temp)\\b"
        },
        {
          "name": "storage.type.nativx",
          "match": "\\b(let|var|const)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.primitive.nativx",
          "match": "\\b(f32|f64|i32|i64|u32|bool|str)\\b"
        },
        {
          "name": "support.type.math.nativx",
          "match": "\\b(vec2|vec3|vec4|mat4|quat|Vec2|Vec3|Vec4|Mat4|Quat|Transform3D|Camera3D)\\b"
        },
        {
          "name": "support.class.ecs.nativx",
          "match": "\\b(World|EntityId|CommandBuffer|LocalTransform|GlobalTransform|RigidBody3D|ColliderAabb|MeshRender|Texture2D|Mesh|AudioBuffer)\\b"
        }
      ]
    },
    "hardware_modules": {
      "patterns": [
        {
          "name": "support.constant.hardware.nativx",
          "match": "\\b(nx|gpu|device|imu|haptics|fs|audio|net|world|cmds|ui)\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.nativx",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.nativx",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.nativx",
          "match": "\\\\."
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.nativx",
          "match": "\\b[0-9]+\\.[0-9]+\\b"
        },
        {
          "name": "constant.numeric.integer.nativx",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.nativx",
          "match": "(->|\\.\\.|&mut|==|!=|<=|>=|&&|\\|\\||\\+=|-=|\\*=|/=|[=+\\-*/%!<>])"
        }
      ]
    }
  }
}
